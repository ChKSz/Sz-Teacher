# 复制本文件为 .env 再填写。.env 已被 .gitignore 排除，不会进 Git。

# 模型提供商（OpenAI 兼容接口）
LLM_BASE_URL=https://cn2.s2api.top/v1
LLM_API_KEY=
LLM_MODEL=gpt-6.1-sol

# 服务器（以下都有默认值，可不填）
# PORT=3000
# HOST=127.0.0.1          # 只允许本机/反向代理访问；直接对外开放时用 0.0.0.0
# DATA_DIR=data           # 数据库与上传图片的目录
# SECURE_COOKIES=false    # 通过 HTTPS 访问时设为 true
# TRUST_PROXY=false       # 在 Nginx 反向代理后面时设为 true（用于识别真实 IP）
# INITIAL_PASSWORD=       # 部署时预设访问密码（至少 6 位），避免上线后被别人抢先设置
